# URL pública de tu proyecto en Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública 'anon' para acceso desde el cliente (Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-aqui

# NOTA: No compartas tu clave 'service_role' en este archivo.
# Este archivo sirve como plantilla. Copia su contenido a .env.local para desarrollo.
